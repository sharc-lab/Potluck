module top_control_s_axi
#(parameter
    C_S_AXI_ADDR_WIDTH = {{ C_S_AXI_ADDR_WIDTH }},
    C_S_AXI_DATA_WIDTH = {{ C_S_AXI_DATA_WIDTH }}
)(
    input  wire                          ACLK,
    input  wire                          ARESET,
    input  wire                          ACLK_EN,
    input  wire [C_S_AXI_ADDR_WIDTH-1:0] AWADDR,
    input  wire                          AWVALID,
    output wire                          AWREADY,
    input  wire [C_S_AXI_DATA_WIDTH-1:0] WDATA,
    input  wire [C_S_AXI_DATA_WIDTH/8-1:0] WSTRB,
    input  wire                          WVALID,
    output wire                          WREADY,
    output wire [1:0]                    BRESP,
    output wire                          BVALID,
    input  wire                          BREADY,
    input  wire [C_S_AXI_ADDR_WIDTH-1:0] ARADDR,
    input  wire                          ARVALID,
    output wire                          ARREADY,
    output wire [C_S_AXI_DATA_WIDTH-1:0] RDATA,
    output wire [1:0]                    RRESP,
    output wire                          RVALID,
    input  wire                          RREADY,
    output wire                          interrupt,
{% for port in user_defined_ports_output %}
    output wire [{{ port.width-1 }}:0]                   {{ port.name }},
{% endfor %}
{% for port in user_defined_ports_input %}
    input wire [{{ port.width-1 }}:0]                    {{ port.name }},
    input wire                           {{ port.name }}_ap_vld,
{% endfor %}
    output wire                          ap_start,
    input  wire                          ap_done,
    input  wire                          ap_ready,
    input  wire                          ap_idle
);
