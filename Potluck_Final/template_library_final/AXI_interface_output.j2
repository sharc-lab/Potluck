reg [{{ bit_width - 1 }}:0] sel_{{ output_AXI_name }}_AWVALID;
always @ (*) begin
    case (sel_{{ output_AXI_name }}_AWVALID)
        {%- for mapping in case_mappings %}
        {{ bit_width }}'d{{ loop.index0 }}: begin
            {{ output_AXI_name }}_AWVALID = {{ mapping.func_name }}_AWVALID;
        end
        {%- endfor %}
        // Reserved default case
        {{ bit_width }}'d{{ (2**bit_width) - 1 }}: begin
            {{ output_AXI_name }}_AWVALID = 1'b0;
        end
        default: begin
            {{ output_AXI_name }}_AWVALID = 1'b0;
        end
    endcase
end

always @ (*) begin
    if (ap_CS_fsm[0] != 1'b1) begin
        sel_{{ output_AXI_name }}_AWVALID = next_fsm_state_reg[{{ fsm_state_range }}];
    end else begin
        // Assign the default code: 2^bit_width - 1
        sel_{{ output_AXI_name }}_AWVALID = {{ bit_width }}'d{{ (2**bit_width) - 1 }};
    end
end

