{%- for port_name in extracted_ap_signals %}
wire {{ instance_name }}_{{port_name}};
{%- endfor %}
reg {{ instance_name }}_ap_start_reg;
{%- for signal_name, (signal_width, flag) in final_dict.items() %}
  {%- set is_scalar = (signal_width == 1) %}
  {%- set is_out_reg = (flag == 1) %}
  {%- if '_address0' in signal_name or '_address1' in signal_name or '_ce0' in signal_name or '_ce1' in signal_name or '_we0' in signal_name or '_we1' in signal_name or '_d0' in signal_name or '_d1' in signal_name or is_out_reg%}
    {%- if is_scalar %}
wire {{ instance_name }}_{{ signal_name }};
    {%- else %}
wire [{{ signal_width - 1 }}:0] {{ instance_name }}_{{ signal_name }};
    {%- endif %}
  {%- else %}
    {%- if is_scalar %}
reg {{ instance_name }}_{{ signal_name }};
    {%- else %}
reg [{{ signal_width - 1 }}:0] {{ instance_name }}_{{ signal_name }};
    {%- endif %}
  {%- endif %}
{%- endfor %}

{% set fixed_ports_map = {
    "ap_clk": "ap_clk",
    "ap_rst": "ap_rst_n_inv"
} %}
{{ top_func_name }} {{ instance_name }}(
    {%- for port in port_list %}
    .{{ port }}({{ fixed_ports_map[port] if port in fixed_ports_map else instance_name ~ "_" ~ port }}){% if not loop.last %},{% endif %}
    {%- endfor %}
);



