
reg [{{ bit_width - 1 }}:0] sel_{{ input_AXI_reg }};
always @ (*) begin
    case (sel_{{ input_AXI_reg }})
        {%- for mapping in case_mappings %}
        {{ bit_width }}'d{{ loop.index0 }}: begin
            {{ input_AXI_reg }} = {{ mapping.func_name }};
        end
        {%- endfor %}
        // Reserved default case
        {{ bit_width }}'d{{ (2**bit_width) - 1 }}: begin
            {{ input_AXI_reg }} = 'bx;
        end
        default: begin
            {{ input_AXI_reg }} = 'bx;
        end
    endcase
end

always @ (*) begin
    if (ap_CS_fsm[0] != 1'b1) begin
        sel_{{ input_AXI_reg }} = next_fsm_state_reg[{{ fsm_state_range }}];
    end else begin
        // Assign the default code: 2^bit_width - 1
        sel_{{ input_AXI_reg }} = {{ bit_width }}'d{{ (2**bit_width) - 1 }};
    end
end



