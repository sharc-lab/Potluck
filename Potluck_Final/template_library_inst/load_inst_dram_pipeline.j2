input  [0:0] m_axi_INPUT2_BUSER;
output  [{{data_width - 1}}:0] fifo_1_din;
input   fifo_1_full_n;
output   fifo_1_write;
input  [31:0] inst_num;
input  [{{64 - bit_width + 2}}:0] sext_ln22;

reg ap_idle;
reg m_axi_INPUT2_RREADY;

(* fsm_encoding = "none" *) reg   [0:0] ap_CS_fsm;
wire    ap_CS_fsm_pp0_stage0;
wire    ap_enable_reg_pp0_iter0;
reg    ap_enable_reg_pp0_iter1;
reg    ap_enable_reg_pp0_iter2;
reg    ap_idle_pp0;
reg    ap_block_state2_pp0_stage0_iter1;
reg    ap_block_state3_pp0_stage0_iter2;
reg    ap_block_pp0_stage0_subdone;
wire   [0:0] icmp_ln22_fu_90_p2;
reg    ap_condition_exit_pp0_iter0_stage0;
wire    ap_loop_exit_ready;
reg    ap_ready_int;
reg    INPUT2_blk_n_R;
wire    ap_block_pp0_stage0;
reg    fifo_1_blk_n;
reg    ap_block_pp0_stage0_11001;
reg   [{{data_width - 1}}:0] INPUT2_addr_read_reg_129;
reg   [30:0] i_fu_46;
wire   [30:0] add_ln22_fu_96_p2;
wire    ap_loop_init;
reg   [30:0] ap_sig_allocacmp_i_load;
reg    ap_block_pp0_stage0_01001;
reg    fifo_1_write_local;
